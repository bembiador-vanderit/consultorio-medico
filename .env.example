# PostgreSQL
POSTGRES_DB=consultorio_medico
POSTGRES_USER=consultorio_user
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://consultorio_user:change_this_local_password@postgres:5432/consultorio_medico
SECRET_KEY=replace_with_a_long_random_secret_key

# Initial administrator
INITIAL_ADMIN_EMAIL=admin@consultorio.com
INITIAL_ADMIN_PASSWORD=change_this_admin_password
INITIAL_ADMIN_NAME=Administrador inicial

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
