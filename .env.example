# PostgreSQL
POSTGRES_DB=consultorio_medico
POSTGRES_USER=consultorio_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Backend
# Must match the PostgreSQL credentials above.
DATABASE_URL=
SECRET_KEY=
APP_TIMEZONE=America/Santo_Domingo
# Backend host mapping. Set only hosts served by your trusted reverse proxy.
# Example: TENANT_HOSTS_JSON={"osiris.example.test":"pilot"}
TENANT_HOSTS_JSON=
# Example: PLATFORM_HOSTS_JSON=["admin.example.test"]
PLATFORM_HOSTS_JSON=

# Initial administrator
INITIAL_ADMIN_EMAIL=admin@consultorio.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador inicial

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional Tailscale private ingress. Start explicitly with profile tailscale.
# Resolve the actual Docker host gateway; never use a subnet or wildcard.
# Serve must point at http://127.0.0.1:8002, not the public backend port.
ATLAS_TRUSTED_PROXY_IP=
ATLAS_TRUSTED_PROXY_HOST=
ATLAS_PROXY_PORT=8002

# Enable only after applying 0056_clinical_forms to the target database.
VITE_CLINICAL_FORM_DESIGNER_ENABLED=false
