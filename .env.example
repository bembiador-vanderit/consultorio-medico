# PostgreSQL
POSTGRES_DB=consultorio_medico
POSTGRES_USER=consultorio_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Backend
# Must match the PostgreSQL credentials above.
DATABASE_URL=
SECRET_KEY=
APP_TIMEZONE=America/Santo_Domingo
# Backend host mapping. Set only hosts served by your trusted reverse proxy.
# Example: TENANT_HOSTS_JSON={"osiris.example.test":"pilot"}
TENANT_HOSTS_JSON=
# Example: PLATFORM_HOSTS_JSON=["admin.example.test"]
PLATFORM_HOSTS_JSON=

# Initial administrator
INITIAL_ADMIN_EMAIL=admin@consultorio.com
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador inicial

# Application ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
